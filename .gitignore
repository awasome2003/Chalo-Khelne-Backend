# Dependencies
node_modules/

# Environment files (NEVER commit real secrets)
.env
.env.local
.env.production
.env.development
.env.*.local
!.env.example

# Credentials / service accounts / keys
firebase-admin_sdk.json
*-credentials.json
*-service-account.json
serviceAccountKey.json
*.pem

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
*.local

# Uploads (local disk storage)
uploads/

# Scratch / debug artifacts
debug-output.txt
tournament-details.txt

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# NOTE: package-lock.json is intentionally NOT ignored — it MUST be committed
# for reproducible production installs (npm ci).

# A renamed .git from a previous session — never commit a repository as files.
.git_disabled/
