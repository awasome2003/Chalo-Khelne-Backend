# Dependencies
node_modules/

# ── Environment (NEVER commit real secrets) ───────────────────────────
# Blanket-ignore every .env variant, then re-admit the committed template.
# The previous list enumerated .env.local / .env.production / .env.development
# / .env.*.local, which left .env.test and .env.staging trackable.
.env
.env.*
!.env.example

# ── Credentials / service accounts / keys (NEVER commit) ──────────────
# `credentials.json` is listed explicitly: `*-credentials.json` requires a dash
# before "credentials" and does NOT match the bare filename. That exact gap is
# how the mobile repo ended up with its release keystore passwords in git.
#
# NOTE: a .gitignore rule does NOT untrack an already-tracked file. When adding
# a secret here, also run: git rm --cached <file>
credentials.json
credentials/
firebase-admin_sdk.json
*-credentials.json
*-service-account.json
serviceAccountKey.json
google-services.json
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
*.local

# Test coverage (jest)
coverage/

# Uploads (local disk storage — user content, never source)
uploads/

# Scratch / debug artifacts
debug-output.txt
tournament-details.txt

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# NOTE: package-lock.json is intentionally NOT ignored — it MUST be committed
# for reproducible production installs (npm ci).

# A renamed .git from a previous session — never commit a repository as files.
.git_disabled/
